{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":disableDependencyDashboard"
  ],
  "assigneesFromCodeOwners": true,
  "packageRules": [
    {
      "description": "paperweight publishes 2.0.0-SNAPSHOT, which sorts above the 2.0.0 betas and hides them",
      "matchDepNames": ["io.papermc.paperweight.userdev"],
      "allowedVersions": "!/-SNAPSHOT$/"
    }
  ]
}
