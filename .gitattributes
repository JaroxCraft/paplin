#
# https://help.github.com/articles/dealing-with-line-endings/
#

# Automatically handle line endings for text files
* text=auto

# Source files should use LF
*.kt            text eol=lf
*.kts           text eol=lf
*.java          text eol=lf

# Config files should use LF
*.yml           text eol=lf
*.yaml          text eol=lf
*.toml          text eol=lf
*.properties    text eol=lf
*.json          text eol=lf
*.md            text eol=lf
*.xml           text eol=lf

# Scripts
*.sh            text eol=lf
/gradlew        text eol=lf

# Windows script files should use crlf
*.bat           text eol=crlf
*.cmd           text eol=crlf

# Binary files should be left untouched
*.jar           binary
*.png           binary
*.jpg           binary
*.gif           binary
